# Odoo image and PostgreSQL image. Pin digests for reproducible deployments.
ODOO_IMAGE=odoo:20
PG_IMAGE=postgres:18

# PostgreSQL role and initial database. These values are applied only the first
# time the PostgreSQL data directory is initialised. Changing them later does
# NOT change an existing cluster.
POSTGRES_USER=odoo20
POSTGRES_PASSWORD=odoo@20
POSTGRES_DB=postgre

# Odoo master password (database manager / backup / restore operations).
ODOO_ADMIN_PASSWORD=Admin@20

# Odoo database this instance serves. With this set, http://host:<port>/odoo
# opens the database directly. Set one distinct value per instance.
ODOO_DB_NAME=odoo20

# Host ports published by the odoo20 service.
ODOO_HTTP_PORT=10020
ODOO_CHAT_PORT=20020

# Private Docker network and container names (override for multi-instance).
ODOO_NETWORK=odoo20_internal
ODOO_CONTAINER_NAME=odoo20
ODOO_DB_CONTAINER_NAME=odoo20-db

# Used only with docker-compose.traefik.yml
ODOO_DOMAIN=odoo.example.com
DOCKER_PROXY_NETWORK=proxy
CERTSRESOLVER=letsencrypt