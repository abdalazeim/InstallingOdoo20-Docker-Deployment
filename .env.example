ODOO_IMAGE=odoo:20
PG_IMAGE=postgres:18
POSTGRES_USER=odoo20
POSTGRES_PASSWORD=odoo@20
POSTGRES_DB=postgre
ODOO_ADMIN_PASSWORD=Admin@20
ODOO_HTTP_PORT=10020
ODOO_CHAT_PORT=20020
ODOO_NETWORK=odoo20_internal
ODOO_CONTAINER_NAME=odoo20
ODOO_DB_CONTAINER_NAME=odoo20-db

# Used only with docker-compose.traefik.yml
ODOO_DOMAIN=odoo.example.com
DOCKER_PROXY_NETWORK=proxy
CERTSRESOLVER=letsencrypt
